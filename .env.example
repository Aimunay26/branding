# Copia este fichero a .env y pon tus claves reales.
# Nada de lo que hay aquí es un secreto: es la plantilla. El .env sí lo es y
# está en .gitignore.

# Proveedor de IA para las recomendaciones: gemini (por defecto) o claude.
PROVEEDOR_IA=gemini

# --- Gemini (por defecto). Clave en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Claude (alternativa). Clave en https://console.anthropic.com/settings/keys
#     También sirve un perfil de `ant auth login`, que deja ANTHROPIC_AUTH_TOKEN
#     en el entorno: si lo tienes, deja esta línea vacía.
ANTHROPIC_API_KEY=sk-ant-...

# Modelo concreto dentro del proveedor elegido. Déjalo vacío para el de por defecto.
# Los precios son POR INFORME y en DÓLARES: las tarifas de Anthropic y de Google
# se facturan en USD y las de app/ia/*.py están en USD por millón de tokens.
# Antes aquí ponía «€» y era falso.
#   gemini: gemini-3.5-flash (rápido y barato) · gemini-2.5-pro (mejor)
#           tarifas sin verificar contra la documentación de Google: compruébalas
#           antes de facturarle esto a nadie.
#   claude: claude-opus-5 (por defecto, ~0,08 $) · claude-opus-4-8 (~0,08 $)
#           claude-sonnet-5 (~0,03 $) · claude-haiku-4-5 (~0,02 $)
# Si escribes un identificador que no está en la tabla de TARIFAS, el informe se
# genera igual pero el coste sale a 0: no es que sea gratis, es que no se sabe.
MODELO_IA=

# --- Acceso con Google (opcional). Crea un ID de cliente de tipo
#     "Aplicación web" en https://console.cloud.google.com/apis/credentials
#     y añade http://localhost:8000 a "Orígenes autorizados de JavaScript".
#     No hace falta secreto de cliente: solo verificamos el ID token del botón.
#     Si lo dejas vacío, no se carga nada de accounts.google.com, no se pinta el
#     botón de Google y todo el mundo entra como anónimo — se sigue guardando
#     TODO en la base de datos.
GOOGLE_CLIENT_ID=

# Pon 1 cuando sirvas por https. Con 0 la cookie de sesión también viaja por
# http, que es lo que hace falta en localhost. Con 1 sobre http el navegador
# descarta la cookie SIN AVISAR y nadie mantiene la sesión: si el login "no
# hace nada" en producción, mira esto primero.
COOKIE_SEGURA=0

# Días que se conserva el cuestionario de quien entra sin cuenta, contados
# desde su última visita. Sus informes ya emitidos no se borran.
DIAS_RETENCION_ANONIMOS=30

# Token de la cabecera X-Admin-Token para GET /admin/informes (el listado de
# todos los informes). Vacío = esa ruta devuelve 404 y no existe.
ADMIN_TOKEN=
